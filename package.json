{
  "name": "aulas_mackenzie",
  "version": "1.0.0",
  "description": "Hub de Disciplinas - MBA em Engenharia de Dados - Universidade Presbiteriana Mackenzie",
  "scripts": {
    "inspect:aula03": "node aulas/data_visualization/aula_03_visualizacao_de_dados_numericos/laboratorio/scripts/inspect_schema.js",
    "lab:aula03": "node aulas/data_visualization/aula_03_visualizacao_de_dados_numericos/laboratorio/server/index.js",
    "test:lab:aula03": "node --test aulas/data_visualization/aula_03_visualizacao_de_dados_numericos/laboratorio/tests/*.test.js",
    "test:e2e:lab:aula03": "playwright test --config=playwright.lab.config.js",
    "quiz:aula05:check": "node scripts/quiz_db.mjs",
    "quiz:aula05:apply": "node scripts/quiz_db.mjs --apply",
    "tbl:aula06:check": "node scripts/tbl_db.mjs",
    "tbl:aula06:apply": "node scripts/tbl_db.mjs --apply",
    "tbl:aula06:e2e": "node scripts/tbl_e2e.mjs",
    "entregas:check": "node scripts/entregas_db.mjs",
    "entregas:apply": "node scripts/entregas_db.mjs --apply",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0"
  },
  "dependencies": {
    "express": "^5.2.1",
    "openai": "^7.7.0",
