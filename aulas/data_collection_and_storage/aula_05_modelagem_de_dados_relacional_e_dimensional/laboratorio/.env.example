# Copie para .env (que está no .gitignore) e troque os valores.
# Gere senhas com: openssl rand -base64 24

# --- Postgres local (docker compose) ---
POSTGRES_USER=livraria
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=livraria
DATABASE_URL_LOCAL=postgresql://livraria:troque-esta-senha@localhost:5432/livraria

# --- Postgres no Railway ---
# Copie o valor de DATABASE_PUBLIC_URL do serviço Postgres (exige Public Access ligado).
# DATABASE_URL aponta para a rede privada do projeto e não funciona a partir do Codespace.
DATABASE_PUBLIC_URL=

# --- MinIO local (docker compose) ---
MINIO_ROOT_USER=aula05
MINIO_ROOT_PASSWORD=troque-esta-senha-tambem

# --- MinIO usado pelo pipeline (local ou Railway) ---
# Local: localhost:9000 e S3_USE_SSL=false
# Railway: dominio-gerado.up.railway.app (sem https://) e S3_USE_SSL=true
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=aula05
S3_SECRET_KEY=troque-esta-senha-tambem
S3_USE_SSL=false
S3_REGION=us-east-1

# --- Caminhos do lakehouse (ajuste ao que a Aula 04 do grupo gravou) ---
SILVER_LIVROS=s3://silver/livros/*/*.parquet
SILVER_PTAX=s3://silver/ptax/*.parquet
GOLD_PREFIX=s3://gold/dimensional/
