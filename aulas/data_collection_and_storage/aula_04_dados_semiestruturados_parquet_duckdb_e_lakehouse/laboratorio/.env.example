# Copie para .env (local) e para .env.railway (MinIO publicado na Aula 01).
# Nenhum dos dois entra no Git. Nunca cole estes valores em prompt, print ou commit.
# Os nomes S3_* são os mesmos da Aula 02, para o job reaproveitar o .env do grupo.

# --- Usado pelo docker compose (MinIO local) ---
MINIO_ROOT_USER=aluno
# Gere uma senha com: openssl rand -base64 24
MINIO_ROOT_PASSWORD=troque-esta-senha
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Usado pelo job e por sql/rodar_sql.py (local ou Railway) ---
# Local:   http://localhost:9000
# Railway: https://<dominio-gerado-pelo-railway-para-a-porta-9000>
# O esquema define o USE_SSL do secret do DuckDB (http = false, https = true).
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=aluno
S3_SECRET_KEY=troque-esta-senha
S3_REGION=us-east-1

# --- Lakehouse ---
BUCKET_RAW=raw
BUCKET_SILVER=silver
BUCKET_GOLD=gold
# Data a processar (AAAA-MM-DD). Vazio = data de hoje no fuso America/Sao_Paulo.
DATA_PROCESSAMENTO=
