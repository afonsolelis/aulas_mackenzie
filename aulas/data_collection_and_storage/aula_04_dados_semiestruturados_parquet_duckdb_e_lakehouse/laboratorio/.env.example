# Copie para .env (que deve estar no .gitignore) e troque as senhas.
# Nunca versione o .env nem cole estes valores em prompt, print ou commit.
# Gere senhas com: openssl rand -base64 24

# --- MinIO (lake) ---
MINIO_ROOT_USER=aula04admin
MINIO_ROOT_PASSWORD=troque-por-uma-senha-forte
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=aula04admin
S3_SECRET_KEY=troque-por-uma-senha-forte
S3_REGION=us-east-1
BUCKET_RAW=raw
BUCKET_SILVER=silver
# Bucket só para os testes automatizados; nunca use raw nos testes.
BUCKET_TESTE=teste

# --- RabbitMQ (fila) ---
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
RABBITMQ_USER=ingestao
RABBITMQ_PASSWORD=troque-por-outra-senha-forte
FILA_INGESTAO=ingestao

# --- ClickHouse (tabela de pouso) ---
CLICKHOUSE_HOST=localhost
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_USER=ingestao
CLICKHOUSE_PASSWORD=troque-por-mais-uma-senha-forte
CLICKHOUSE_DATABASE=ingestao
CLICKHOUSE_TABELA=db_ingestion
# O ClickHouse 26.8 liga async_insert por padrão. O consumidor já faz o lote: 0 desliga.
CLICKHOUSE_ASYNC_INSERT=0

# --- Servidor de ingestão ---
API_PORT=8000
# Registro de domínios: data_tag fora desta lista recebe 422.
DOMINIOS=telemetria,livros,ptax
# Micro-lote: flush a cada FLUSH_N envelopes ou FLUSH_SEGUNDOS, o que vier primeiro.
FLUSH_N=500
FLUSH_SEGUNDOS=2
# Corpo HTTP maior que isto recebe 413 (1 MiB).
HTTP_MAX_BYTES=1048576
